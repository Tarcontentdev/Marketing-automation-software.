{% if items|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover tweet-list" id="tweetTable">
            <thead>
            <tr>
                {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'checkall': 'true',
                    'target': '#tweetTable',
                }) }}

                {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'social.tweet',
                        'orderBy': 'e.name',
                        'text': 'mailvotech.core.name',
                        'class': 'col-tweet-name',
                        'default': true,
                }) }}

                {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'social.tweet',
                        'orderBy': 'e.id',
                        'text': 'mailvotech.core.id',
                        'class': 'visible-md visible-lg col-asset-id',
                }) }}
            </tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td>
                        {{ include('@MailVotechCore/Helper/list_actions.html.twig', {
                                'item': item,
                                'templateButtons': {
                                    'edit': securityIsGranted('mailvotechSocial:tweets:edit'),
                                    'delete': securityIsGranted('mailvotechSocial:tweets:delete'),
                                },
                                'routeBase': 'mailvotech_tweet',
                                'langVar': 'mailvotech.integration.Twitter',
                                'nameGetter': 'getName',
                        }) }}
                    </td>
                    <td>
                        <div>
                            {{ include('@MailVotechCore/Helper/publishstatus_icon.html.twig', {
                                    'item': item,
                                    'model': 'social.tweet',
                            }) }}
                            <a href="{{ path('mailvotech_tweet_action', {'objectAction': 'edit', 'objectId': item.id}) }}" data-toggle="ajax">
                                {{ item.name }}
                            </a>
                        </div>
                        {{ include('@MailVotechCore/Helper/description--inline.html.twig', {
                            'description': item.description
                        }) }}
                    </td>
                    <td class="visible-md visible-lg">{{ item.id }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="panel-footer">
        {{ include('@MailVotechCore/Helper/pagination.html.twig', {
                'totalItems': items|length,
                'page': page,
                'limit': limit,
                'menuLinkId': 'mailvotech_tweet_index',
                'baseUrl': path('mailvotech_tweet_index'),
                'sessionVar': 'social.tweet',
                'routeBase': 'tweet',
        }) }}
    </div>
{% else %}
    {{ include('@MailVotechCore/Helper/noresults.html.twig', {'tip': 'mailvotech.mailvotech.social.tweet.noresults.tip'}) }}
{% endif %}
