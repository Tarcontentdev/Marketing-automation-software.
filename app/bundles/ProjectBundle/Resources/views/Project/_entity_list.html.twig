{% set hasEntities = false %}
{% for entityType, entityData in projectEntities %}
	{% if entityData.count > 0 %}
		{% set hasEntities = true %}
	{% endif %}
{% endfor %}

{% if hasEntities %}
	{% for entityType, entityData in projectEntities %}
		{% if entityData.count > 0 %}
			<div id="{{ entityType }}-list-wrapper" class="panel panel-default mt-md">
				<div class="panel-heading pa-0 toolbar--table-toolbar">
					<div class="d-flex ai-center jc-space-between list-toolbar toolbar--toolbar-content h-48">
						<h4 class="panel-title fw-light mb-0 pl-md">{{ entityData.label }}</h4>
						<a class="btn btn-ghost" data-toggle="ajaxmodal" data-target="#MailVotechSharedModal" href="{{ path('mailvotech_project_action', {'objectAction': 'addEntity', 'objectId': project.getId(), 'entityType': entityType}) }}" data-header="{{ 'mailvotech.project.add'|trans }} {{ entityData.label|trans }}" aria-label="{{ 'mailvotech.project.add'|trans }} {{ entityData.label|trans }}">
							<i class="ri-add-line" aria-hidden="true" focusable="false"></i>
							<span class="hidden-xs hidden-sm">{{ 'mailvotech.project.add'|trans }}</span>
						</a>
					</div>
				</div>


				<div class="page-list">
					<div class="table-responsive">
						<table class="table table-hover {{ entityType }}-list mb-0">
							<thead>
								<tr>
									<th class="col-actions"></th>
									<th class="col-name col-lg-5">{{ 'mailvotech.core.name'|trans }}</th>
									<th class="visible-lg col-dateAdded">{{ 'mailvotech.lead.import.label.dateAdded'|trans }}</th>
									<th class="visible-lg col-dateModified">{{ 'mailvotech.lead.import.label.dateModified'|trans }}</th>
									<th class="visible-lg col-createdBy">{{ 'mailvotech.core.createdby'|trans }}</th>
									<th class="visible-md visible-lg col-id">{{ 'mailvotech.core.id'|trans }}</th>
								</tr>
							</thead>
							<tbody>
								{% for entity in entityData.entities %}
									<tr id="row_{{ entityType }}_{{ entity.getId() }}">
										<td class="col-xs-1">
											{{- include('@MailVotechCore/Helper/list_actions.html.twig', {
																				'item': entity,
																				'templateButtons': {
																						'edit': false,
																						'clone': false,
																						'delete': false
																				},
																				'customButtons': {
																						'remove': {
																								'confirm': {
																										'btnClass': false,
																										'btnText': 'mailvotech.project.remove_from_project'|trans,
																										'message': 'mailvotech.project.form.confirm_remove'|trans({'%name%': entity.getName(), '%project%': project.getName()}),
																										'confirmAction': path('mailvotech_project_action', {'objectAction': 'remove', 'objectId': project.getId(), 'entityType': entityType, 'entityId': entity.getId()}),
																										'template': 'delete'
																								},
																								'iconClass': 'ri-subtract-line',
																								'priority': 100
																						}
																				},
																		}) -}}
										</td>
										<td>
										{% if entityData.detailRoute %}
												<a href="{{ path(entityData.detailRoute.route, entityData.detailRoute.getParameters(entity.getId())) }}" data-toggle="ajax">
														{{ entity.getName()|purify }}
												</a>
										{% else %}
												{{ entity.getName()|purify }}
										{% endif %}
										</td>
										<td class="visible-lg" title="{{ entity.getDateAdded() ? dateToFullConcat(entity.getDateAdded()) : '' }}">
											{{ entity.getDateAdded() ? dateToDate(entity.getDateAdded()) : '' }}
										</td>
										<td class="visible-lg" title="{{ entity.getDateModified() ? dateToFullConcat(entity.getDateModified()) : '' }}">
											{{ entity.getDateModified() ? dateToDate(entity.getDateModified()) : '' }}
										</td>
										<td class="visible-lg">
											{{ entity.getCreatedByUser() ? entity.getCreatedByUser() : '' }}
										</td>
										<td class="visible-md visible-lg">
											<span class="text-muted">{{ entity.getId() }}</span>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		{% endif %}
	{% endfor %}
{% else %}
	{{- include('@MailVotechCore/Helper/noresults.html.twig', {
        'header': 'mailvotech.project.no_assigned_entities.header',
        'message': 'mailvotech.project.no_assigned_entities.message'
    }) -}}
{% endif %}
