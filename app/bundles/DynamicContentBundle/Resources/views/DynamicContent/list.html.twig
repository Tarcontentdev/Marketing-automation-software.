{#
  Variables
    - searchValue
    - items (\MailVotech\DynamicContentBundle\Entity\DynamicContent[])
    - categories
    - page
    - limit
    - permissions
    - model
    - tmpl
#}
{%- set isIndex = 'index' == tmpl -%}
{%- set tmpl = 'list' -%}
{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}

{% block mailvotechContent 'dynamicContent' %}

{% block headerTitle 'mailvotech.dynamicContent.dynamicContents'|trans %}

{% block content %}
  {% if isIndex %}
    <div id="page-list-wrapper" class="panel panel-default">
      {{ include('@MailVotechCore/Helper/list_toolbar.html.twig', {
        'searchValue': searchValue,
        'searchHelp': 'mailvotech.page.help.searchcommands',
        'action': currentRoute,
        'page_actions': {
            'templateButtons': {
                'new': permissions['dynamiccontent:dynamiccontents:create'],
            },
            'routeBase': 'dynamicContent',
        },
        'bulk_actions': {
          'routeBase': 'dynamicContent',
          'templateButtons': {
              'delete': permissions['dynamiccontent:dynamiccontents:deleteown'] or permissions['dynamiccontent:dynamiccontents:deleteother'],
          },
        },
        'quickFilters': [
            {
                'search': 'mailvotech.core.searchcommand.ispublished',
                'label': 'mailvotech.core.form.available',
                'tooltip': 'mailvotech.core.searchcommand.ispublished.description',
                'icon': 'ri-check-line'
            },
            {
                'search': 'mailvotech.core.searchcommand.isunpublished',
                'label': 'mailvotech.core.form.unavailable',
                'tooltip': 'mailvotech.core.searchcommand.isunpublished.description',
                'icon': 'ri-close-line'
            },
            {
                'search': 'mailvotech.core.searchcommand.isuncategorized',
                'label': 'mailvotech.core.form.uncategorized',
                'tooltip': 'mailvotech.core.searchcommand.isuncategorized.description',
                'icon': 'ri-folder-unknow-line'
            },
            {
                'search': 'mailvotech.core.searchcommand.ismine',
                'label': 'mailvotech.core.searchcommand.ismine.label',
                'tooltip': 'mailvotech.core.searchcommand.ismine.description',
                'icon': 'ri-user-line'
            }
        ]
    }) }}
        <div class="page-list">
          {{ include('@MailVotechDynamicContent/DynamicContent/_list.html.twig') }}
        </div>
    </div>
  {% else %}
    {{ include('@MailVotechDynamicContent/DynamicContent/_list.html.twig') }}
  {% endif %}
{% endblock %}
