{%- set isIndex = 'index' == tmpl -%}
{%- set tmpl = 'list' -%}
{% extends '@MailVotechCore/Default/raw_output.html.twig' %}

{% block content %}
  {% if isIndex %}
    <div class="box-layout mb-lg">
        <div class="col-xs-12 col-md-9 col-lg-10 va-m">
            {{ include('@MailVotechLead/Note/_list_filter_form.html.twig') }}
        </div>
        <div class="col-xs-12 col-md-3 col-lg-2 va-t">
          {% if permissions['create'] %}
              {% include '@MailVotechCore/Helper/button.html.twig' with {
                  buttons: [
                      {
                          label: 'mailvotech.lead.add.note',
                          variant: 'primary',
                          icon: 'ri-add-line',
                          href: path('mailvotech_contactnote_action', {'leadId': lead.id, 'objectAction': 'new'}),
                          attributes: {
                              'class': 'btn-leadnote-add pull-right',
                              'data-toggle': 'ajaxmodal',
                              'data-target': '#MailVotechSharedModal',
                              'data-header': 'mailvotech.lead.note.header.new'|trans
                          }
                      }
                  ]
              } %}
          {% endif %}
        </div>
    </div>
    <div id="NoteList">
  {% endif %}

  {{ include('@MailVotechLead/Note/_list.html.twig') }}

  {% if isIndex %}
    </div>
  {% endif %}
{% endblock %}
