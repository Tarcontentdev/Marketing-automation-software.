{#
  Variables
    - event
    - lead
#}
{% set objects = event.details.fields is defined ? event.details.fields : {} %}
{% for key, value in event.details %}
    {% if 'fields' != key and 'dateIdentified' != key and 'dateModified' != key %}
        {% set objects = objects|merge({(key): value}) %}
    {% endif %}
{% endfor %}
{% if objects|length > 0 %}
    {% if 'create' == event.eventType %}
        {{ include('@MailVotechLead/Auditlog/_table.html.twig', { 'objects': objects }) }}
    {% elseif 'delete' == event.eventType %}
        {{ 'mailvotech.lead.audit.deleted'|trans }}
        {{ include('@MailVotechLead/Auditlog/_single_value_table.html.twig', { 'objects': objects }) }}
    {% elseif 'update' == event.eventType %}
        {{ include('@MailVotechLead/Auditlog/_table.html.twig', { 'objects': objects }) }}
    {% elseif 'identified' == event.eventType %}
        {{ 'mailvotech.lead.audit.identified'|trans }}
    {% elseif 'ipadded' == event.eventType %}
        {{ 'mailvotech.lead.audit.accessed'|trans }} {{ event.details|first|join(',') }}
    {% elseif 'merged' == event.eventType %}
        {{ 'mailvotech.lead.audit.merged'|trans }}
    {% endif %}
{% endif %}
