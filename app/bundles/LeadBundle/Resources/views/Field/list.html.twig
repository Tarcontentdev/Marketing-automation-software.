{#
  Variables
    - items
    - searchValue
    - permissions
    - tmpl
    - totalItems
    - limit
    - page
    - currentRoute
    - mailvotechContent
    - isIndex
    - contentOnly
    - modalView
    - template
#}
{% set isIndex = 'index' == tmpl ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}

{% block mailvotechContent %}leadfield{% endblock %}

{% block headerTitle %}{{ 'mailvotech.lead.field.header.index'|trans }}{% endblock %}

{% block content %}
  {% if isIndex %}
    <div id="page-list-wrapper" class="panel panel-default">
        {{ include('@MailVotechCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'action': currentRoute,
            'page_actions': {
                'templateButtons': {
                    'new': true,
                },
                'routeBase': 'contactfield',
                'langVar': 'lead.field',
            },
            'bulk_actions': {
                'langVar': 'lead.field',
                'routeBase': 'contactfield',
                'templateButtons': {
                    'delete': permissions['lead:fields:full'],
                },
            },
        }) }}
        <div class="page-list">
  {% endif %}

  {% if items|length > 0 %}
      <div class="table-responsive">
          <table class="table table-hover leadfield-list" id="leadFieldTable" class="overflow:auto">
              <thead>
              <tr>
                  <th class="col-leadfield-orderhandle"></th>
                  {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'checkall': 'true',
                    'target': '#leadFieldTable',
                }) }}
                  {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar': 'leadfield',
                    'orderBy': 'f.label',
                    'text': 'mailvotech.lead.field.label',
                    'class': 'col-leadfield-label'
                  }) }}
                  {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar': 'leadfield',
                    'orderBy': 'f.alias',
                    'text': 'mailvotech.core.alias',
                    'class': 'visible-md visible-lg col-leadfield-alias'
                  }) }}
                  {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar': 'leadfield',
                    'orderBy': 'f.object',
                    'text': 'mailvotech.lead.field.object',
                    'class': 'visible-md visible-lg col-leadfield-group'
                  }) }}
                  {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar': 'leadfield',
                    'orderBy': 'f.group',
                    'text': 'mailvotech.lead.field.group',
                    'class': 'visible-md visible-lg col-leadfield-group'
                  }) }}
                  {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar': 'leadfield',
                    'orderBy': 'f.type',
                    'text': 'mailvotech.lead.field.type',
                    'class': 'col-leadfield-type'
                  }) }}
                  {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar': 'leadfield',
                    'orderBy': 'f.id',
                    'text': 'mailvotech.core.id',
                    'class': 'visible-md visible-lg col-leadfield-id'
                  }) }}
                   <th class="visible-sm visible-md visible-lg col-leadfield-statusicons"></th>
              </tr>
              </thead>
              <tbody>
              {% for item in items %}
                  <tr id="field_{{ item.id }}">
                      <td><i class="ri-xl ri-draggable text-secondary"></i></td>
                      <td>
                          {{ include('@MailVotechCore/Helper/list_actions.html.twig', {
                                  'item': item,
                                  'templateButtons': {
                                      'edit': item.getColumnIsNotRemoved() ? false : permissions['lead:fields:full'],
                                      'clone': item.getColumnIsNotRemoved() ? false : permissions['lead:fields:full'],
                                      'delete': item.isFixed or item.getColumnIsNotRemoved() ? false : permissions['lead:fields:full'],
                                  },
                                  'routeBase': 'contactfield',
                                  'langVar': 'lead.field',
                                  'pull': 'left',
                          }) }}
                      </td>
                      <td>
                      <span class="ellipsis">
                          {{ include('@MailVotechCore/Helper/publishstatus_icon.html.twig', {
                                      'item': item,
                                      'model': 'lead.field',
                                      'disableToggle': item.disablePublishChange,
                                      'aditionalLabel': (item.columnIsNotCreated ? 'mailvotech.lead.field.being_created_in_background'|trans : '') ~ (item.getColumnIsNotRemoved() ? 'mailvotech.lead.field.being_removed_in_background'|trans : ''),
                          }) }}
                          <a href="{{ path('mailvotech_contactfield_action', {'objectAction': 'edit', 'objectId': item.id}) }}" data-toggle="ajax">{{ item.label }}</a>
                          {{ customContent('lead.field.name', _context) }}
                      </span>
                      </td>
                      <td class="visible-md visible-lg">
                          {% set tokenText = item.object == 'user' ? '{ownerfield=' ~ item.alias ~ '}' : '{contactfield=' ~ item.alias ~ '}' %}
                          {% include '@MailVotechCore/Components/code-snippet.html.twig' with {
                              variant: 'inline',
                              innerText: tokenText,
                              copyText: tokenText,
                              copyButtonDescription: 'mailvotech.lead.field.copy_token'
                          } %}
                      </td>
                      <td class="visible-md visible-lg">{{ ('mailvotech.'~item.object~'.'~item.object)|trans }}</td>
                      <td class="visible-md visible-lg">{{ ('mailvotech.lead.field.group.'~item.group)|trans }}</td>
                      <td>{{ translatorConditional('mailvotech.core.type.'~item.type, 'mailvotech.lead.field.type.'~item.type) }}</td>
                      <td class="visible-md visible-lg">{{ item.id }}</td>
                      <td class="visible-sm visible-md visible-lg">
                          {% if item.isRequired %}
                              <i class="ri-asterisk" data-toggle="tooltip" data-placement="left" title="{{ 'mailvotech.lead.field.tooltip.required'|trans }}"></i>
                          {% endif %}
                          {% if item.isVisible %}
                              <i class="ri-eye-line-slash" data-toggle="tooltip" data-placement="left" title="{{ 'mailvotech.lead.field.tooltip.invisible'|trans }}"></i>
                          {% endif %}
                          {% if item.isFixed %}
                              <i class="ri-lock-fill" data-toggle="tooltip" data-placement="left" title="{{ 'mailvotech.lead.field.tooltip.fixed'|trans }}"></i>
                          {% endif %}
                          {% if item.isListable %}
                              <i class="ri-list-check " data-toggle="tooltip" data-placement="left" title="{{ 'mailvotech.lead.field.tooltip.listable'|trans }}"></i>
                          {% endif %}
                          {% if item.isPubliclyUpdatable %}
                              <i class="ri-earth-line text-danger " data-toggle="tooltip" data-placement="left" title="{{ 'mailvotech.lead.field.tooltip.public'|trans }}"></i>
                          {% endif %}
                          {% if item.isUniqueIdentifer %}
                              <i class="ri-key-2-line " data-toggle="tooltip" data-placement="left" title="{{ 'mailvotech.lead.field.tooltip.isuniqueidentifer'|trans }}"></i>
                          {% endif %}
                          {% if item.isIsIndex %}
                              <i class="ri-menu-search-line " data-toggle="tooltip" data-placement="left" title="{{ 'mailvotech.lead.field.tooltip.isindex'|trans }}"></i>
                          {% endif %}
                      </td>
                  </tr>
              {% endfor %}
              </tbody>
          </table>
      </div>
      <div class="panel-footer">
          {{ include('@MailVotechCore/Helper/pagination.html.twig', {
                  'totalItems': totalItems,
                  'page': page,
                  'limit': limit,
                  'baseUrl': path('mailvotech_contactfield_index'),
                  'sessionVar': 'leadfield',
          }) }}
      </div>
  {% else %}
      {{ include('@MailVotechCore/Helper/noresults.html.twig') }}
  {% endif %}

  {% if isIndex %}
        </div>
    </div>
  {% endif %}
{% endblock %}
