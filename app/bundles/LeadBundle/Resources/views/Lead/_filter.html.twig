{% if isIndex %}
    {% set toolbarButtons = [
        {
            'attr': {
            'class': 'hidden-xs btn btn-ghost btn--icon-only btn-sm btn-nospin',
            'href': 'javascript: void(0)',
            'onclick': 'MailVotech.toggleLiveLeadListUpdate();',
            'id': 'liveModeButton',
            'data-toggle': false,
            'data-max-id': maxLeadId,
        },
            'tooltip': 'mailvotech.lead.lead.live_update'|trans,
            'iconClass': 'ri-refresh-line',
        }
    ] %}
    {% if 'list' == indexMode %}
        {% set toolbarButtons = toolbarButtons|merge([{
            'attr': {
                'class': 'hidden-xs btn btn--icon-only btn-sm btn-nospin'~(anonymousShowing ? ' btn-primary' : ' btn-ghost'),
                'href': 'javascript: void(0)',
                'onclick': 'MailVotech.toggleAnonymousLeads();',
                'id': 'anonymousLeadButton',
                'data-anonymous': 'mailvotech.lead.lead.searchcommand.isanonymous'|trans,
            },
            'tooltip': 'mailvotech.lead.lead.anonymous_leads'|trans,
            'iconClass': 'ri-spy-line',
        }]) %}
    {% endif %}
    <div id="page-list-wrapper" class="{% if items|length > 0 or searchValue is not empty %}panel {% endif %}panel-default">
        {%- set pageButtons = [] %}
{% if permissions['lead:leads:create'] %}
    {% set pageButtons = pageButtons|merge([{
        'attr': {
            'class': 'btn btn-ghost btn-nospin quickadd',
            'data-toggle': 'ajaxmodal',
            'data-target': '#MailVotechSharedModal',
            'href': path('mailvotech_contact_action', {'objectAction': 'quickAdd'}),
            'data-header': 'mailvotech.lead.lead.menu.quickadd'|trans,
        },
        'iconClass': 'ri-flashlight-line',
        'btnText': 'mailvotech.lead.lead.menu.quickadd',
        'primary': true,
    }]) %}

    {% if permissions['lead:imports:create'] %}
        {% set pageButtons = pageButtons|merge([{
            'attr': {
                'href': path('mailvotech_import_action', {'object': 'contacts', 'objectAction': 'new'}),
            },
            'iconClass': 'ri-import-line',
            'btnText': 'mailvotech.lead.lead.import',
        }]) %}
    {% endif %}

    {% if permissions['lead:imports:view'] %}
        {% set pageButtons = pageButtons|merge([{
            'attr': {
                'href': path('mailvotech_import_index', {'object': 'contacts'}),
            },
            'iconClass': 'ri-history-line',
            'btnText': 'mailvotech.lead.lead.import.index',
        }]) %}
    {% endif %}
{% endif %}

{% if (permissions['lead:leads:editown'] or permissions['lead:leads:editother']) %}
    {% set bulkActionsCustom = [
      {
          'attr': {
              'class': 'btn btn-ghost btn-sm btn-nospin',
              'data-toggle': 'ajaxmodal',
              'data-target': '#MailVotechSharedModal',
              'href': path('mailvotech_segment_batch_contact_view'),
              'data-header': 'mailvotech.lead.batch.lists'|trans,
          },
          'btnText': 'mailvotech.lead.batch.lists'|trans,
          'iconClass': 'ri-pie-chart-line',
      },
      {
          'attr': {
              'class': 'btn btn-ghost btn-sm btn-nospin',
              'data-toggle': 'ajaxmodal',
              'data-target': '#MailVotechSharedModal',
              'href': path('mailvotech_contact_action', {'objectAction': 'batchStages'}),
              'data-header': 'mailvotech.lead.batch.stages'|trans,
          },
          'btnText': 'mailvotech.lead.batch.stages'|trans,
          'iconClass': 'ri-barricade-line flip-vertically',
      },
      {
          'attr': {
              'class': 'btn btn-ghost btn-sm btn-nospin',
              'data-toggle': 'ajaxmodal',
              'data-target': '#MailVotechSharedModal',
              'href': path('mailvotech_tagmanager_batch_index_action'),
              'data-header': 'mailvotech.tagmanager.batch.tags'|trans,
          },
          'btnText': 'mailvotech.tagmanager.batch.tags'|trans,
          'iconClass': 'ri-hashtag',
      },
      {
          'attr': {
              'class': 'btn btn-ghost btn-sm btn-nospin',
              'data-toggle': 'ajaxmodal',
              'data-target': '#MailVotechSharedModal',
              'href': path('mailvotech_contact_action', {'objectAction': 'batchCampaigns'}),
              'data-header': 'mailvotech.lead.batch.campaigns'|trans,
          },
          'btnText': 'mailvotech.lead.batch.campaigns'|trans,
          'iconClass': 'ri-megaphone-line',
      },
      {
          'attr': {
              'class': 'btn btn-ghost btn-sm btn-nospin',
              'data-toggle': 'ajaxmodal',
              'data-target': '#MailVotechSharedModal',
              'href': path('mailvotech_contact_action', {'objectAction': 'batchOwners'}),
              'data-header': 'mailvotech.lead.batch.owner'|trans,
          },
          'btnText': 'mailvotech.lead.batch.owner'|trans,
          'iconClass': 'ri-user-2-line',
      },
      {
          'attr': {
              'class': 'btn btn-ghost btn-sm btn-nospin',
              'data-toggle': 'ajaxmodal',
              'data-target': '#MailVotechSharedModal',
              'href': path('mailvotech_contact_action', {'objectAction': 'batchFindReplace'}),
              'data-header': 'mailvotech.core.find_replace'|trans,
          },
          'btnText': 'mailvotech.core.find_replace'|trans,
          'iconClass': 'ri-find-replace-line',
      },
      {
          'attr': {
              'class': 'btn btn-ghost btn-sm btn-nospin',
              'data-toggle': 'ajaxmodal',
              'data-target': '#MailVotechSharedModal',
              'href': path('mailvotech_contact_action', {'objectAction': 'batchDnc'}),
              'data-header': 'mailvotech.lead.batch.dnc'|trans,
          },
          'btnText': 'mailvotech.lead.batch.dnc'|trans,
          'iconClass': 'ri-prohibited-line text-danger',
      },
    ] %}
{% endif %}

{{- include('@MailVotechCore/Helper/list_toolbar.html.twig', {
    'searchValue': searchValue|default(''),
    'action': currentRoute,
    'customButtons': toolbarButtons,
    'page_actions': {
        'templateButtons': {'new': permissions['lead:leads:create']},
        'routeBase': 'contact',
        'langVar': 'lead.lead',
        'customButtons': pageButtons,
    },
    'bulk_actions': {
        'target': '#leadTable',
        'templateButtons': {
            'delete': (permissions['lead:leads:deleteown'] or permissions['lead:leads:deleteother'])
        },
        'customButtons': bulkActionsCustom|default([]),
        'routeBase': 'contact',
        'langVar': 'lead.lead',
    },
    'quickFilters': [
        {
            'search': 'mailvotech.core.searchcommand.ismine',
            'label': 'mailvotech.core.searchcommand.ismine.label',
            'tooltip': 'mailvotech.core.searchcommand.ismine.description',
            'icon': 'ri-user-line'
        },
        {
            'search': 'mailvotech.lead.lead.searchcommand.isunowned',
            'label': 'mailvotech.lead.lead.searchcommand.isunowned.label',
            'tooltip': 'mailvotech.lead.lead.searchcommand.isunowned.description',
            'icon': 'ri-user-unfollow-line'
        },
        {
            'search': (('mailvotech.lead.lead.searchcommand.dnc'|trans) ~ ':' ~ ('mailvotech.lead.lead.searchcommand.dnc.any'|trans)),
            'label': 'mailvotech.lead.lead.searchcommand.dnc.label',
            'tooltip': 'mailvotech.lead.lead.searchcommand.dnc.description',
            'icon': 'ri-prohibited-line'
        }
    ]
}) -}}
<div class="btn-group ml-5 sr-only ">
    <span data-toggle="tooltip" title="{{ 'mailvotech.lead.tooltip.list'|trans }}" data-placement="left">
      <a id="table-view" href="{{ path('mailvotech_contact_index', {'page': page, 'view': 'list'}) }}" data-toggle="ajax" class="btn btn-ghost">
          <i class="ri-table-line"></i>
      </a>
    </span>
    <span data-toggle="tooltip" title="{{ 'mailvotech.lead.tooltip.grid'|trans }}" data-placement="left">
      <a id="card-view" href="{{ path('mailvotech_contact_index', {'page': page, 'view': 'grid'}) }}" data-toggle="ajax" class="btn btn-ghost">
        <i class="ri-layout-grid-line"></i>
      </a>
    </span>
</div>
        <div class="page-list">
{% endif %}
