{#
  Variables
    - form
    - objectName
    - step
    - currentRoute
    - contentOnly
    - modalView
    - template
#}
{% extends '@MailVotechCore/Default/content.html.twig' %}

{% block mailvotechContent %}leadImport{% endblock %}

{% block headerTitle %}
  {{ 'mailvotech.lead.import.leads'|trans({'%object%': objectName|trans}) }}
{% endblock %}

{% block actions %}
  {% if step is defined and constant('MailVotech\\LeadBundle\\Controller\\ImportController::STEP_UPLOAD_CSV') == step %}
    {{- include('@MailVotechCore/Helper/page_actions.html.twig', {
            'routeBase': 'import',
            'langVar': 'lead.import',
            'templateButtons': {'close': true},
            'routeVars': {
                'close': {
                    'object': app.request.get('object', 'contacts'),
                },
            },
    }) -}}
  {% endif %}
{% endblock %}

{% block content %}
  {% if step is defined and constant('MailVotech\\LeadBundle\\Controller\\ImportController::STEP_UPLOAD_CSV') == step %}
    {{ include('@MailVotechLead/Import/_upload_form.html.twig') }}
  {% else %}
    {{ include('@MailVotechLead/Import/_mapping_form.html.twig') }}
  {% endif %}
{% endblock %}
