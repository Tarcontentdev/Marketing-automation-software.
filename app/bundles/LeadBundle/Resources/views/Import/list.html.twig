{% set isIndex = 'index' == tmpl ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}

{% block mailvotechContent %}{{ mailvotechContent }}{% endblock %}

{% block headerTitle %}{{ 'mailvotech.lead.import.list'|trans }}{% endblock %}

{% block actions %}
  {{ include('@MailVotechCore/Helper/page_actions.html.twig', {
        'templateButtons': {
            'new': permissions[permissionBase~':create'],
        },
        'routeBase': 'import',
        'query': {'object': app.request.get('object', 'contacts')},
  }) }}
{% endblock %}

{% block content %}
  {% if isIndex %}
    <div id="page-list-wrapper" class="panel panel-default">
      <div class="page-list">
  {% endif %}

  {{ include('@MailVotechLead/Import/_list.html.twig') }}

  {% if isIndex %}
        </div>
    </div>
  {% endif %}
{% endblock %}
