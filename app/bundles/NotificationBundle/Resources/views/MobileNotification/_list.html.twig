{#
  Variables
    - searchValue
    - items
    - totalItems
    - page
    - limit
    - tmpl
    - permissions
    - model
    - security
#}
{% if items|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover notification-list">
            <thead>
            <tr>
                {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'checkall': 'true',
                }) }}

                {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'mobile_notification',
                        'orderBy': 'e.name',
                        'text': 'mailvotech.core.name',
                        'class': 'col-notification-name',
                        'default': true,
                }) }}

                {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'mobile_notification',
                        'orderBy': 'c.title',
                        'text': 'mailvotech.core.category',
                        'class': 'visible-md visible-lg col-notification-category',
                }) }}

                <th class="visible-sm visible-md visible-lg col-notification-stats">{{ 'mailvotech.core.stats'|trans }}</th>

                {{ include('@MailVotechCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'mobile_notification',
                        'orderBy': 'e.id',
                        'text': 'mailvotech.core.id',
                        'class': 'visible-md visible-lg col-notification-id',
                }) }}
            </tr>
            </thead>
            <tbody>
            {# @var \MailVotech\NotificationBundle\Entity\Notification $item #}
            {% for item in items %}
                {% set type = item.notificationType %}
                <tr>
                    <td>
                        {{ include('@MailVotechCore/Helper/list_actions.html.twig', {
                                'item': item,
                                'templateButtons': {
                                    'edit': securityHasEntityAccess(permissions['notification:mobile_notifications:editown'], permissions['notification:mobile_notifications:editother'], item.createdBy),
                                    'delete': securityHasEntityAccess(permissions['notification:mobile_notifications:deleteown'], permissions['notification:mobile_notifications:deleteother'], item.createdBy),
                                },
                                'routeBase': 'mobile_notification',
                                'customButtons': [
                                    {
                                        'attr': {
                                            'data-toggle': 'ajaxmodal',
                                            'data-target': '#MailVotechSharedModal',
                                            'data-header': 'mailvotech.notification.mobile_notification.preview'|trans,
                                            'data-footer': 'false',
                                            'href': path('mailvotech_mobile_notification_action', {'objectId': item.id, 'objectAction': 'preview'}),
                                        },
                                        'btnText': 'mailvotech.notification.mobile_notification.preview'|trans,
                                        'iconClass': 'ri-share-forward-box-fill',
                                    },
                                ]
                        }) }}
                    </td>
                    <td>
                        <div>
                            {% if 'template' == type %}
                                {{ include('@MailVotechCore/Helper/publishstatus_icon.html.twig', {'item': item, 'model': 'notification'}) }}
                            {% else %}
                                <i class="ri-fw ri-lg ri-toggle-fill text-secondary disabled"></i>
                            {% endif %}
                            <a href="{{ path('mailvotech_mobile_notification_action', {'objectAction': 'view', 'objectId': item.id}) }}" data-toggle="ajax">
                                {{ item.name }}
                                {% if 'list' == type %}
                                    <span data-toggle="tooltip" title="{{ 'mailvotech.notification.icon_tooltip.list_notification'|trans }}"><i class="ri-fw ri-list-check"></i></span>
                                {% endif %}
                                {% if item.isTranslation() %}
                                    <span data-toggle="tooltip" title="{{ 'mailvotech.core.icon_tooltip.translation'|trans }}"><i class="ri-fw ri-translate fs-14"></i></span>
                                {% endif %}
                            </a>
                        </div>
                    </td>
                    <td class="visible-md visible-lg">
                        {{ include('@MailVotechCore/Modules/category--expanded.html.twig', {'category': item.category}) }}
                    </td>
                    <td class="visible-sm visible-md visible-lg col-stats">
                        <span class="mt-xs label label-green"
                              data-toggle="tooltip"
                              title="{{ 'mailvotech.channel.stat.leadcount.tooltip'|trans }}">
                            <a href="{{ path('mailvotech_contact_index', {'search': 'mailvotech.lead.lead.searchcommand.mobile_sent'|trans ~ ':' ~ item.id}) }}">
                                {{- 'mailvotech.notification.stat.sentcount'|trans({'%count%': item.getSentCount(true)}) -}}
                            </a>
                        </span>
                    </td>
                    <td class="visible-md visible-lg">{{ item.id }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="panel-footer">
        {{ include('@MailVotechCore/Helper/pagination.html.twig', {
                'totalItems': totalItems,
                'page': page,
                'limit': limit,
                'baseUrl': path('mailvotech_mobile_notification_index'),
                'sessionVar': 'mobile_notification',
        }) }}
    </div>
{% else %}
    {{ include('@MailVotechCore/Helper/noresults.html.twig') }}
{% endif %}
