{% set isIndex = tmpl == 'index' ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}
{% block mailvotechContent %}sms{% endblock %}
{% block headerTitle %}{{ 'mailvotech.sms.smses'|trans }}{% endblock %}
{% block content %}
    {% if isIndex %}
    <div id="page-list-wrapper" class="{% if items|length > 0 or searchValue is not empty %}panel {% endif %}panel-default">
        {{- include('@MailVotechCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'searchId': 'sms-search',
            'action': currentRoute,
            'page_actions': {
                'templateButtons': {
                    'new': permissions['sms:smses:create']
                },
                'routeBase': 'sms'
            },
            'quickFilters': [
                {
                    'search': 'mailvotech.core.searchcommand.ispublished',
                    'label': 'mailvotech.core.form.available',
                    'tooltip': 'mailvotech.core.searchcommand.ispublished.description',
                    'icon': 'ri-check-line'
                },
                {
                    'search': 'mailvotech.core.searchcommand.isunpublished',
                    'label': 'mailvotech.core.form.unavailable',
                    'tooltip': 'mailvotech.core.searchcommand.isunpublished.description',
                    'icon': 'ri-close-line'
                },
                {
                    'search': 'mailvotech.core.searchcommand.isuncategorized',
                    'label': 'mailvotech.core.form.uncategorized',
                    'tooltip': 'mailvotech.core.searchcommand.isuncategorized.description',
                    'icon': 'ri-folder-unknow-line'
                },
                {
                    'search': 'mailvotech.core.searchcommand.ismine',
                    'label': 'mailvotech.core.searchcommand.ismine.label',
                    'tooltip': 'mailvotech.core.searchcommand.ismine.description',
                    'icon': 'ri-user-line'
                }
            ]
        }) -}}

        <div class="page-list">
            {{ block('listResults') }}
        </div>
    </div>

    {{ include('@MailVotechCore/Modules/protip.html.twig', {
        tip: random(['mailvotech.protip.sms.concise', 'mailvotech.protip.sms.timesensitive', 'mailvotech.protip.sms.compliance'])
    }) }}
    {% else %}
		{{ block('listResults') }}
	{% endif %}
{% endblock %}

{% block listResults %}
{% if items|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover sms-list">
            <thead>
            <tr>
                {{- include(
                    '@MailVotechCore/Helper/tableheader.html.twig',
                    {
                        'checkall'        : 'true',
                        'routeBase'       : 'sms',
                        'templateButtons' : {
                            'delete' : permissions['sms:smses:deleteown'] or permissions['sms:smses:deleteother'],
                        }
                    }
                ) -}}

                {{- include(
                    '@MailVotechCore/Helper/tableheader.html.twig',
                    {
                        'sessionVar' : 'sms',
                        'orderBy'    : 'e.name',
                        'text'       : 'mailvotech.core.name',
                        'class'      : 'col-sms-name',
                        'default'    : true,
                    }
                ) -}}

                {{- include(
                    '@MailVotechCore/Helper/tableheader.html.twig',
                    {
                        'sessionVar' : 'sms',
                        'orderBy'    : 'c.title',
                        'text'       : 'mailvotech.core.category',
                        'class'      : 'visible-md visible-lg col-sms-category',
                    }
                ) -}}

                <th class="visible-sm visible-md visible-lg col-sms-stats">{{ 'mailvotech.core.stats'|trans }}</th>

                {{- include(
                    '@MailVotechCore/Helper/tableheader.html.twig',
                    {
                        'sessionVar' : 'sms',
                        'orderBy'    : 'e.id',
                        'text'       : 'mailvotech.core.id',
                        'class'      : 'visible-md visible-lg col-sms-id',
                    }
                ) -}}
            </tr>
            </thead>
            <tbody>
            {# @var item \MailVotech\SmsBundle\Entity\Sms #}
            {% for item in items %}
                {% set type = item.getSmsType() %}
                {% set media = item.getMedia() %}
                <tr>
                    <td>
                        {% set edit = securityHasEntityAccess(
                            permissions['sms:smses:editown'],
                            permissions['sms:smses:editother'],
                            item.getCreatedBy()
                        ) %}
                        {% set customButtons = [
                            {
                                'attr' : {
                                    'data-toggle' : 'ajaxmodal',
                                    'data-target' : '#MailVotechSharedModal',
                                    'data-header' : 'mailvotech.sms.smses.header.preview'|trans,
                                    'data-footer' : 'false',
                                    'href'        : path('mailvotech_sms_action', { 'objectId' : item.getId(), 'objectAction' : 'preview' }),
                                },
                                'btnText'   : 'mailvotech.sms.preview'|trans,
                                'iconClass' : 'ri-share-forward-box-fill',
                            }
                        ] %}
                        {{- include(
                            '@MailVotechCore/Helper/list_actions.html.twig',
                            {
                                'item'            : item,
                                'templateButtons' : {
                                    'edit'   : edit,
                                    'clone'  : permissions['sms:smses:create'],
                                    'delete' : securityHasEntityAccess(
                                        permissions['sms:smses:deleteown'],
                                        permissions['sms:smses:deleteother'],
                                        item.getCreatedBy()
                                    ),
                                },
                                'routeBase'     : 'sms',
                                'customButtons' : customButtons,
                            }
                        ) -}}
                    </td>
                    <td>
                        <div>
                            {{- include('@MailVotechCore/Helper/publishstatus_icon.html.twig',
                                {
                                    'item'  : item,
                                    'model' : 'sms',
                                }
                            ) -}}
                            <a href="{{ path('mailvotech_sms_action', {'objectAction' : 'view', 'objectId' : item.getId()}) }}" data-toggle="ajax">
                                {{ item.getName() }}
                                {% if item.isTranslation() %}
                                    <span data-toggle="tooltip" title="{{ 'mailvotech.core.icon_tooltip.translation'|trans }}"><i class="ri-fw ri-translate fs-14"></i></span>
                                {% endif %}
                                {% if 'list' == type %}
                                    <span data-toggle="tooltip" title="{{ 'mailvotech.sms.icon_tooltip.list_sms'|trans }}">
                                        <i class="ri-pie-chart-line fs-14"></i>
                                    </span>
                                {% endif %}
                                {% if media is not empty %}
                                    <span data-toggle="tooltip" title="{{ 'mailvotech.sms.icon_tooltip.has_media'|trans }}"><i class="ri-file-image-line"></i></span>
                                {% endif %}
                            </a>
                            {{ include('@MailVotechProject/Modules/projects.html.twig') }}
                        </div>
                    </td>
                    <td class="visible-md visible-lg">
                        {{ include('@MailVotechCore/Modules/category--expanded.html.twig', {'category': item.getCategory()}) }}
                    </td>
                        {{- include('@MailVotechSms/Sms/list_stats.html.twig', { 'item' : item }) -}}
                    <td class="visible-md visible-lg">{{ item.getId() }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="panel-footer">
        {{- include('@MailVotechCore/Helper/pagination.html.twig', {
            'totalItems' : totalItems,
            'page'       : page,
            'limit'      : limit,
            'baseUrl'    : path('mailvotech_sms_index'),
            'sessionVar' : 'sms',
        }) -}}
    </div>
{% elseif not configured %}
    {{- include('@MailVotechCore/Helper/noresults.html.twig', { 'header' : 'mailvotech.sms.disabled', 'message' : 'mailvotech.sms.enable.in.configuration' }) -}}
{% else %}
    {% if searchValue is not empty %}
        {{- include('@MailVotechCore/Helper/noresults.html.twig', {'tip' : 'mailvotech.category.noresults.tip'}) -}}
    {% else %}
        <div class="mt-80 col-md-offset-2 col-lg-offset-3 col-md-8 col-lg-5 height-auto">
            {% set childContainer %}
                <div class="mt-32 mb-md">
                    {% include '@MailVotechCore/Components/pictogram.html.twig' with {
                        'pictogram': 'mobile--chat',
                        'size': '80'
                    } %}
                </div>
            {% endset %}
            {% include '@MailVotechCore/Components/content-block.html.twig' with {
                heading: 'mailvotech.sms.contentblock.heading',
                subheading: 'mailvotech.sms.contentblock.subheading',
                copy: 'mailvotech.sms.contentblock.copy',
                childContainer: childContainer
            } %}
        </div>
    {% endif %}
{% endif %}
{% endblock %}
