{% extends '@MailVotechUser/Security/login_base.html.twig' %}
{% block pageTitle %}{% trans %}mailvotech.user.auth.header{% endtrans %}{% endblock %}

{% block content %}
    <form class="auth-form" name="login" role="form" action="{{ path('mailvotech_user_logincheck') }}" method="post" novalidate>
        <h1 class="auth-title">{% trans %}mailvotech.user.auth.header{% endtrans %}</h1>

        <div class="auth-field">
            <label for="username">{% trans %}mailvotech.user.auth.form.loginusername{% endtrans %}</label>
            <input
                type="text"
                id="username"
                name="_username"
                class="form-control"
                value="{{ last_username|escape }}"
                required
                autofocus
                autocomplete="username"
            />
        </div>

        <div class="auth-field">
            <div class="auth-field-header">
                <label for="password">{% trans %}mailvotech.core.password{% endtrans %}</label>
                <a href="{{ path('mailvotech_user_passwordreset') }}" class="auth-forgot">{% trans %}mailvotech.user.user.passwordreset.link{% endtrans %}</a>
            </div>
            <div class="auth-input-wrapper">
                <input
                    type="password"
                    id="password"
                    name="_password"
                    class="form-control"
                    required
                    autocomplete="current-password"
                />
                <button type="button" class="auth-password-toggle" data-target="password" aria-label="Show password">
                    <i class="ri-eye-line" aria-hidden="true"></i>
                    <span class="sr-only">Show password</span>
                </button>
            </div>
        </div>

        <div class="auth-field-actions">
            <label class="auth-checkbox">
                <input type="checkbox" id="remember_me" name="_remember_me" />
                <span>{% trans %}mailvotech.user.auth.form.rememberme{% endtrans %}</span>
            </label>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate')|escape }}"/>

        <button type="submit" class="btn btn-primary btn-lg btn-block auth-submit">
            <span class="auth-btn-text">{% trans %}mailvotech.user.auth.form.loginbtn{% endtrans %}</span>
            <span class="auth-btn-loading" aria-hidden="true">
                <i class="ri-loader-3-line ri-spin"></i>
            </span>
        </button>
    </form>

    {% if integrations is not empty %}
        <div class="auth-divider">
            <span>or</span>
        </div>
        <div class="auth-sso">
            {% for sso in integrations %}
                <a href="{{ path('mailvotech_sso_login', {'integration' : sso.getName()}) }}" class="btn btn-secondary btn-lg auth-sso-btn">
                    {% if sso.getIcon() %}
                        <img class="auth-sso-icon" src="{{ getAssetUrl(sso.getIcon()) }}" alt="{{ ('mailvotech.integration.sso.' ~ sso.getName())|trans }}" />
                    {% endif %}
                    <span>{{ ('mailvotech.integration.sso.' ~ sso.getName())|trans }}</span>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.querySelector('.auth-form');
        if (!form) return;
        form.addEventListener('submit', function () {
            var btn = form.querySelector('.auth-submit');
            if (!btn || btn.disabled) return;
            btn.disabled = true;
            btn.classList.add('auth-submitting');
            btn.setAttribute('aria-busy', 'true');
        });
    });
    </script>
{% endblock %}
