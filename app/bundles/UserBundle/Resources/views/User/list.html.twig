{% set isIndex = tmpl == 'index' ? true : false %}
{% set tmpl = 'list' %}

{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}
{% block mailvotechContent %}user
{% endblock %}
{% block headerTitle %}
	{% trans %}mailvotech.user.users{% endtrans %}
{% endblock %}

{% block content %}
	{% if isIndex %}
	<div id="page-list-wrapper" class="panel panel-default">
		{%- set pageButtons = [] %}
		{% if permissions.create %}
			{% set pageButtons = pageButtons|merge([{
				'attr': {
					'class': 'btn btn-ghost btn--icon-only btn-nospin',
					'href': '#InviteUserModal',
					'data-toggle': 'modal',
				},
				'iconClass': 'ri-team-line',
				'tooltip': 'mailvotech.user.profile.invite',
				'primary': true,
			}]) %}
		{% endif %}
		{{- include('@MailVotechCore/Helper/list_toolbar.html.twig', {
			'searchValue': searchValue,
			'action': currentRoute,
			'page_actions': {
				'templateButtons': {
					'new': permissions['create'],
				},
				'routeBase': 'user',
				'langVar': 'user.user',
				'customButtons': pageButtons,
			},
			'bulk_actions': {
				'routeBase': 'user',
				'langVar': 'user.user',
				'templateButtons': {
					'delete': permissions['delete']
				}
			},
			'quickFilters': [
				{
					'search': 'mailvotech.user.user.searchcommand.isadmin',
					'label': 'mailvotech.user.role.form.isadmin',
					'tooltip': 'mailvotech.core.search.quickfilter.is_admin',
					'icon': 'ri-admin-line'
				},
				{
					'search': 'mailvotech.core.searchcommand.ispublished',
					'label': 'mailvotech.core.form.active',
					'tooltip': 'mailvotech.core.search.quickfilter.is_published',
					'icon': 'ri-check-line'
				},
				{
					'search': 'mailvotech.core.searchcommand.isunpublished',
					'label': 'mailvotech.core.form.inactive',
					'tooltip': 'mailvotech.core.search.quickfilter.is_unpublished',
					'icon': 'ri-close-line'
				}
			]
		}) -}}
		<div class="page-list">
			{{ block('listResults') }}
		</div>
	</div>
	{% else %}
		{{ block('listResults') }}
	{% endif %}

	{% if isIndex and permissions.create and inviteForm %}
		{% set modalAttributes = {} %}
		{% if app.request.query.get('open') == 'invite' %}
			{% set modalAttributes = modalAttributes|merge({'data-auto-open': 'true'}) %}
		{% endif %}

		{% include '@MailVotechCore/Components/modal.html.twig' with {
			id: 'InviteUserModal',
			modalLabel: 'mailvotech.user.invite.title',
			modalContent: include('@MailVotechUser/User/invite.html.twig', { form: inviteForm }),
			type: 'expressive',
			modalAttributes: modalAttributes,
			buttons: [
				{
					'label': 'mailvotech.core.form.cancel'|trans,
					'variant': 'secondary',
					'attributes': {
						'data-dismiss': 'modal'
					}
				},
				{
					'label': 'mailvotech.user.invite.send'|trans,
					'variant': 'primary',
					'onclick': "mQuery('#InviteUserModal').find('#invite-user-form button[type=submit]').trigger('click');"
				}
			]
		} %}
	{% endif %}
{% endblock %}

{% block listResults %}
	<div class="table-responsive">
		<table class="table table-hover user-list" id="userTable">
			<thead>
				<tr>
					{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'checkall'        : 'true',
                    'target'          : '#userTable'
            }) -}}

					<th class="visible-md visible-lg col-user-avatar"></th>
					{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar' : 'user',
                    'orderBy'    : 'u.lastName, u.firstName, u.username',
                    'text'       : 'mailvotech.core.name',
                    'class'      : 'col-user-name',
                    'default'    : true,
                }) -}}
					{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar' : 'user',
                    'orderBy'    : 'u.username',
                    'text'       : 'mailvotech.core.username',
                    'class'      : 'col-user-username',
                }) -}}
					{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar' : 'user',
                    'orderBy'    : 'u.email',
                    'text'       : 'mailvotech.core.type.email',
                    'class'      : 'visible-md visible-lg col-user-email',
                }) -}}

					{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar' : 'user',
                    'orderBy'    : 'r.name',
                    'text'       : 'mailvotech.user.role',
                    'class'      : 'visible-md visible-lg col-user-role',
                }) -}}

					{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar' : 'user',
                    'orderBy'    : 'u.lastLogin',
                    'text'       : 'mailvotech.user.lastlogin',
                    'class'      : 'visible-md visible-lg col-user-lastlogin',
                }) -}}

					{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                    'sessionVar' : 'user',
                    'orderBy'    : 'u.id',
                    'text'       : 'mailvotech.core.id',
                    'class'      : 'visible-md visible-lg col-user-id',
                }) -}}

				</tr>
			</thead>
			<tbody>
				{% for item in items %}
					<tr>
						<td>
							{{- include('@MailVotechCore/Helper/list_actions.html.twig', {
                            'item'            : item,
                            'templateButtons' : {
                                'edit'   : permissions['edit'],
                                'delete' : permissions['delete'],
                            },
                            'routeBase' : 'user',
                            'langVar'   : 'user.user',
                            'pull'      : 'left',
                   }) -}}
						</td>
						<td class="visible-md visible-lg">
							<img class="img img-responsive img-thumbnail w-44" src="{{ gravatarGetImage(item.getEmail(), '50') }}"/>
						</td>
						<td>
							<div>
								{% if item.getId() != currentUserId %}
									{{- include('@MailVotechCore/Helper/publishstatus_icon.html.twig', {
										'item'  : item,
										'model' : 'user',
									}) -}}
								{% endif %}
								{% if permissions['edit'] %}
									<a href="{{ path( 'mailvotech_user_action', {'objectAction' : 'edit', 'objectId' : item.getId()} ) }}" data-toggle="ajax">
										{{ item.getName(true) }}
									</a>
								{% else %}
									{{ item.getName(true) }}
								{% endif %}
							</div>
							<div class="small">
								<em>{{ item.getPosition() }}</em>
							</div>
						</td>
						<td>{{ item.getUsername() }}</td>
						<td class="visible-md visible-lg">
							<a href="mailto: {{ item.getEmail() }}">{{ item.getEmail() }}</a>
						</td>
						<td class="visible-md visible-lg">{{ item.getRole().getName() }}</td>
						<td class="visible-md visible-lg">{{ dateToText(item.getLastLogin(), 'local', 'Y-m-d H:i:s', true) }}</td>
						<td class="visible-md visible-lg">{{ item.getId() }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		<div class="panel-footer">
			{{- include('@MailVotechCore/Helper/pagination.html.twig', {
            'totalItems' : items|length,
            'page'       : page,
            'limit'      : limit,
            'baseUrl'    : path('mailvotech_user_index'),
            'sessionVar' : 'user',
       }) -}}
		</div>
	</div>
{% endblock %}
