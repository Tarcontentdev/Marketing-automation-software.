{% set isIndex = tmpl == 'index' ? true : false %}
{% set tmpl = 'list' %}

{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}
{% block mailvotechContent %}role{% endblock %}
{% block headerTitle %}{% trans %}mailvotech.user.roles{% endtrans %}{% endblock %}

{% block content %}
    {% if isIndex %}
    <div id="page-list-wrapper" class="panel panel-default">
        {{- include('@MailVotechCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'action': currentRoute,
            'page_actions': {
                'templateButtons': {
                    'new': permissions['create'],
                },
                'routeBase': 'role',
                'langVar': 'user.role',
            },
            'bulk_actions': {
                'routeBase': 'role',
                'langVar': 'user.role',
                'templateButtons': {
                    'delete': permissions['delete']
                }
            },
            'quickFilters': [
                {
                    'search': 'mailvotech.user.user.searchcommand.isadmin',
                    'label': 'mailvotech.user.role.form.isadmin',
                    'tooltip': 'mailvotech.core.search.quickfilter.is_admin',
                    'icon': 'ri-admin-line'
                }
            ]
        }) -}}
            <div class="page-list">
                {{ block('listResults') }}
            </div>
    </div>
    {% else %}
        {{ block('listResults') }}
    {% endif %}
{% endblock %}

{% block listResults %}
<div class="table-responsive">
    <table class="table table-hover role-list" id="roleTable">
        <thead>
        <tr>
            {{- include('@MailVotechCore/Helper/tableheader.html.twig',
                {
                    'checkall'        : 'true',
                    'target'          : '#roleTable'
                }
            ) -}}

            {{- include(
                '@MailVotechCore/Helper/tableheader.html.twig',
                {
                    'sessionVar' : 'role',
                    'orderBy'    : 'r.name',
                    'text'       : 'mailvotech.core.name',
                    'class'      : 'col-role-name',
                    'default'    : true,
                }
            ) -}}

            {{- include(
                '@MailVotechCore/Helper/tableheader.html.twig',
                {
                    'sessionVar' : 'role',
                    'orderBy'    : 'r.description',
                    'text'       : 'mailvotech.core.description',
                    'class'      : 'visible-md visible-lg col-role-desc',
                }
            ) -}}
            {{- include(
                '@MailVotechCore/Helper/tableheader.html.twig',
                {
                    'sessionVar' : 'role',
                    'orderBy'    : 'user_count',
                    'text'       : 'mailvotech.user.role.list.thead.usercount',
                    'class'      : 'visible-md visible-lg col-rolelist-usercount',
                }
            ) -}}
            {{- include('@MailVotechCore/Helper/tableheader.html.twig',
                {
                    'sessionVar' : 'role',
                    'orderBy'    : 'r.id',
                    'text'       : 'mailvotech.core.id',
                    'class'      : 'visible-md visible-lg col-role-id',
                }
            ) -}}
        </tr>
        </thead>
        <tbody>
        {% for i in items %}
            {% set item = i[0] %}
            {% set mailvotechTemplateVars = _context|merge({'item' : item}) %}
            <tr>
                <td>
                    {{- include('@MailVotechCore/Helper/list_actions.html.twig',
                        {
                            'item'            : item,
                            'templateButtons' : {
                                'edit'   : permissions['edit'],
                                'clone'  : permissions['create'],
                                'delete' : permissions['delete'],
                            },
                            'routeBase' : 'role',
                            'langVar'   : 'user.role',
                            'pull'      : 'left',
                        }) -}}
                </td>
                <td>
                    {% if permissions['edit'] %}
                        <a href="{{ path('mailvotech_role_action',
                            {'objectAction' : 'edit', 'objectId' : item.getId()}) }}" data-toggle="ajax">
                            {{ item.getName() }}
                            {{ customContent('role.name', mailvotechTemplateVars) }}
                        </a>
                    {% else %}
                        {{ item.getName() }}

                    {% endif %}
                </td>
                <td class="visible-md visible-lg">
                    {{ item.getDescription()|purify }}
                </td>
                <td class="visible-md visible-lg">
                    <a size="sm" class="label label-gray" href="{{ path('mailvotech_user_index',
                        {'search' : (('mailvotech.user.user.searchcommand.role'|trans) ~ ':"' ~ item.getName() ~ '"')}) }}" data-toggle="ajax"{{ i.user_count == 0 ? 'disabled=disabled' : '' }}>
                        {{ 'mailvotech.user.role.list.viewusers_count'|trans(
                            {'%count%' : i.user_count}
                        ) }}
                    </a>
                </td>
                <td class="visible-md visible-lg">
                    {{ item.getId() }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
<div class="panel-footer">
    {{- include('@MailVotechCore/Helper/pagination.html.twig',
        {
            'totalItems' : items|length,
            'page'       : page,
            'limit'      : limit,
            'baseUrl'    : path('mailvotech_role_index'),
            'sessionVar' : 'role',
        }
    ) -}}
</div>
{% endblock %}