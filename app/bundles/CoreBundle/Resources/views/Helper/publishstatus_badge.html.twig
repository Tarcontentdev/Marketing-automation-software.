{% set statusColors = {
    'published': {'icon': 'success', 'text': 'green'},
    'unpublished': {'icon': 'danger', 'text': 'red'},
    'expired': {'icon': 'info', 'text': 'blue'},
    'pending': {'icon': 'info', 'text': 'blue'},
    'sent': {'icon': 'info', 'text': 'blue'},
    'sending': {'icon': 'success', 'text': 'green'},
} %}

{# Define the labels based on the combination of status and publishStatus #}
{% set labelMappings = {
    'available': {
        'published': 'mailvotech.core.form.available',
        'pending': 'mailvotech.core.form.not_yet_available',
        'expired': 'mailvotech.core.form.no_longer_available',
        'unpublished': 'mailvotech.core.form.unavailable',
        'sent': 'mailvotech.email.stat.sent',
        'sending': 'mailvotech.core.form.sending',
    },
    'sending': {
        'published': 'mailvotech.core.form.sending',
        'pending': 'mailvotech.core.form.scheduled_to_send',
        'expired': 'mailvotech.core.form.sending_expired',
        'unpublished': 'mailvotech.core.form.unavailable',
        'sent': 'mailvotech.email.stat.sent',
        'sending': 'mailvotech.core.form.sending',
    },
    'active': {
        'published': 'mailvotech.core.form.active',
        'pending': 'mailvotech.core.form.pending',
        'expired': 'mailvotech.core.form.expired',
        'unpublished': 'mailvotech.core.form.inactive',
        'sent': 'mailvotech.email.stat.sent',
        'sending': 'mailvotech.core.form.sending',
    }
} %}

{% set sendingStatus = sendingStatus|default(entity.getPublishStatus()) %}

{% set labelTextKey = (labelMappings[status|default('active')][sendingStatus]) %}

<div class="label label-{{ statusColors[sendingStatus].text }} d-inline-flex ai-center gap-xs fw-b"{% if simplified is defined and simplified %} size="sm"{% endif %}>
    {% if not (simplified is defined and simplified) %}
        <span aria-hidden="true" focusable="false" class="bg-{{ statusColors[sendingStatus].icon }} publishstatus_dot{% if sendingStatus in ['published', 'sending'] %} publishstatus_pulse{% endif %}">
        </span>
    {% endif %}
    {{ labelTextKey|trans }}
</div>
