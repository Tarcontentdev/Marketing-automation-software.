{% set mailvotech_content = mailvotechContent is defined ? mailvotechContent : '' %}

{% set editor_fonts = getSortedEditorFonts(configGetParameter('editor_fonts')) %}

<script>
    var mailvotechBasePath                  = '{{ app.request.getBasePath() }}';
    var mailvotechBaseUrl                   = "{{ path('mailvotech_base_index') }}";
    var mailvotechAjaxUrl                   = "{{ path('mailvotech_core_ajax') }}";
    var mailvotechAjaxCsrf                  = '{{ securityGetCsrfToken("mailvotech_ajax_post") }}';
    var mailvotechSessionLifetime           = "{{ ini_get('session.gc_maxlifetime') }}";
    var mailvotechImagesPath                = '{{ assetsGetImagesPath() }}';
    var mailvotechAssetPrefix               = '{{ assetsGetPrefix(true) }}';
    var mailvotechContent                   = '{{ mailvotech_content }}';
    var mailvotechEnv                       = '{{ app.environment }}';
    var mailvotechLang                      = {{ translatorGetJsLang()|raw }};
    var mailvotechLocale                    = '{{ app.request.getLocale() }}';
    var mailvotechEditorFonts               = {{ editor_fonts|json_encode|raw }};
    var mailvotechContactExportInBackground = {{ configGetParameter('contact_export_in_background')|number_format }};
    var LoginUserName                   = '{{ (app.user and app.user.getUsername()) ? app.user.getUsername()|escape('js') : 'Anonymous' }}'
    var LoginUserId                     = {{ (app.user and app.user.getId()) ? app.user.getId() : 0 }}
</script>
{{ outputSystemScripts(true) }}
