{% set isIndex = tmpl == 'index' ? true : false %}
{% set tmpl = 'list' %}

{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}

{% block muaticContent %}category
{% endblock %}
{% block headerTitle %}
	{% trans %}mailvotech.category.header.index{% endtrans %}
{% endblock %}

{% block content %}
	{% if isIndex %}
		<div id="page-list-wrapper" class="{% if items|length > 0 or searchValue is not empty %}panel {% endif %}panel-default">
			{# //TODO - Restore these buttons to the listactions when custom content is supported #}
			{# <div class="btn-group">
                    <button type="button" class="btn btn-ghost"><i class="ri-upload-line"></i></button>
                    <button type="button" class="btn btn-ghost"><i class="ri-archive-2-line"></i></button>
                </div> #}
            {{- include('@MailVotechCore/Helper/list_toolbar.html.twig', {
                'searchValue': searchValue,
                'filters': {
                    'bundle': {
                        'options': categoryTypes,
                        'values': {0: bundle},
                        'translateLabels': true,
                    },
                },
                'action': currentRoute,
                'page_actions': {
                    'templateButtons': {
                        'new': permissions[permissionBase ~ ":create"]
                    },
                    'routeBase': 'category',
                    'query': {
                        'bundle': bundle,
                        'show_bundle_select': true,
                    },
                    'editMode': 'ajaxModal',
                    'editAttr': {
                        'data-target': '#MailVotechSharedModal',
                        'data-header': 'mailvotech.category.header.new'|trans,
                        'data-toggle': 'ajaxmodal',
                    },
                },
                'bulk_actions': {
                    'routeBase': 'category',
                    'templateButtons': {
                        'delete': permissions[permissionBase ~ ':delete']
                    },
                    'query': {
                        'bundle': bundle
                    }
                },
                'quickFilters': [
                    {
                        'search': 'mailvotech.core.searchcommand.ispublished',
                        'label': 'mailvotech.core.form.available',
                        'tooltip': 'mailvotech.core.searchcommand.ispublished.description',
                        'icon': 'ri-check-line'
                    },
                    {
                        'search': 'mailvotech.core.searchcommand.isunpublished',
                        'label': 'mailvotech.core.form.unavailable',
                        'tooltip': 'mailvotech.core.searchcommand.isunpublished.description',
                        'icon': 'ri-close-line'
                    }
                ]
            }) -}}
            <div class="page-list">
                {{ block('listResults') }}
			</div>
		</div>
	{% else %}
		{{ block('listResults') }}
	{% endif %}

{% endblock %}


{% block listResults %}
	{% if items|length %}
		<div class="table-responsive">
			<table class="table table-hover category-list" id="categoryTable">
				<thead>
					<tr>
						{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                            'checkall'        :  'true',
                            'target'          :  '#categoryTable'
                        }) -}}

						{{- include(
                        '@MailVotechCore/Helper/tableheader.html.twig',
                            {
                                'sessionVar' :  'category',
                                'text'       :  '',
                                'class'      :  'col-category-color',
                            }
                        ) -}}

						{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                            'sessionVar' :  'category',
                            'orderBy'    :  'c.title',
                            'text'       :  'mailvotech.core.title',
                            'class'      :  'col-category-title',
                            'default'    :  true,
                        }) -}}

						{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                            'sessionVar' :  'category',
                            'orderBy'    :  'c.bundle',
                            'text'       :  'mailvotech.core.type',
                            'class'      :  'visible-md visible-lg col-page-bundle',
                        }) -}}

						{{- include('@MailVotechCore/Helper/tableheader.html.twig', {
                            'sessionVar' :  'category',
                            'orderBy'    :  'c.id',
                            'text'       :  'mailvotech.core.id',
                            'class'      :  'visible-md visible-lg col-page-id',
                        }) -}}
					</tr>
				</thead>
				<tbody>
					{% for item in items %}
						<tr>
							<td>
								{% set title = 'mailvotech.category.header.edit'|trans({'%type%' :  ('mailvotech.' ~ item.getBundle() ~ '.' ~ item.getBundle())|trans, '%name%' :  item.getTitle()}) %}
								{{- include('@MailVotechCore/Helper/list_actions.html.twig', {
                                'item'            :  item,
                                'templateButtons' :  {
                                    'edit'   :  permissions[permissionBase ~ ':edit'],
                                    'delete' :  permissions[permissionBase ~ ':delete'],
                                },
                                'editMode' :  'ajaxmodal',
                                'editAttr' :  {
                                    'data-target' :  '#MailVotechSharedModal',
                                    'data-header' :  title,
                                    'data-toggle' :  'ajaxmodal',
                                },
                                'routeBase' :  'category',
                                'query'     :  {
                                    'bundle' :  bundle,
                                },
                            }) -}}
							</td>
							<td>
								{% set color = item.getColor() %}
								<span class="label label-gray label-category" style="background: {{ '#' not in color ? '#' : ''}}{{ color }};"> </span>
							</td>
							<td>
                                <div>
                                    {{- include('@MailVotechCore/Helper/publishstatus_icon.html.twig',
                                        {'item' :  item, 'model' :  'category', 'query' :  'bundle=' ~ bundle}) -}}
                                    {% if permissions[permissionBase ~ ':edit'] %}
                                        <a href="{{ path('mailvotech_category_action',
                                            {'bundle' :  bundle, 'objectAction' :  'edit', 'objectId' :  item.getId()}) }}" data-toggle="ajaxmodal" data-target="#MailVotechSharedModal" data-header="{{ title }}"
                                    {% endif %}
                                    <span>{{ item.getTitle() }} ({{ item.getAlias() }})</span>
                                    {% if permissions[permissionBase ~ ':edit'] %}
                                        </a>
                                    {% endif %}
                                    {{ customContent('category.name', _context) }}
                                </div>
                                {% set description = item.getDescription() %}
                                {{ include('@MailVotechCore/Helper/description--inline.html.twig', {
                                    'description': item.description
                                }) }}
                            </td>
                            <td class="visible-md visible-lg">
                                {% if categoryTypes[item.getBundle()] is defined %}
                                    {{ categoryTypes[item.getBundle()]|trans }}
                                {% endif %}
                            </td>
                            <td class="visible-md visible-lg">{{ item.getId() }}</td>
						</tr>
                        {% endfor %}
					</table>
					<div class="panel-footer">
						{{- include('@MailVotechCore/Helper/pagination.html.twig',
                {
                    'totalItems' :  items|length,
                    'page'       :  page,
                    'limit'      :  limit,
                    'menuLinkId' :  'mailvotech_category_index',
                    'baseUrl'    :  path(
                        'mailvotech_category_index',
                        {
                            'bundle' :  ('category' == bundle) ? 'all' : bundle,
                        }
                    ),
                    'sessionVar' :  'category',
                }) -}}</div>
				</tbody>
			</div>
		{% else %}
            {% if searchValue is not empty %}
                {{- include('@MailVotechCore/Helper/noresults.html.twig', {'tip' : 'mailvotech.category.noresults.tip'}) -}}
            {% else %}
                <div class="mt-80 col-md-offset-2 col-lg-offset-3 col-md-8 col-lg-5 height-auto">
                    {% set childContainer %}
                        <div class="mt-32 mb-md">
                            {% include '@MailVotechCore/Components/pictogram.html.twig' with {
                                'pictogram': 'folder',
                                'size': '80'
                            } %}
                        </div>
                    {% endset %}
        
                    {{ include('@MailVotechCore/Components/content-block.html.twig', {
                        heading: 'mailvotech.category.contentblock.heading',
                        subheading: 'mailvotech.category.contentblock.subheading',
                        copy: 'mailvotech.category.contentblock.copy',
                        childContainer: childContainer,
                    }) }}
                </div>
            {% endif %}
		{% endif %}
	{% endblock %}
