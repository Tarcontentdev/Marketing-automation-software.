<div id="mailvotech-video-form-embed">
    <form method="post" action="{{ url('mailvotech_form_postresults', {'formId': form.id}) }}">
        {# @var \MailVotech\FormBundle\Entity\Field $f #}
        {% for f in form.fields %}
            {% if f.isCustom and fieldSettings[f.type] is defined %}
                {% if f.isCustom %}
                    {% set params = fieldSettings[f.type] %}
                    {{ f.setCustomParameters(params) }}
                    {% set template = params.template %}
                {% else %}
                    {% set template = '@MailVotechForm/Field/' ~ f.type ~ '.html.twig' %}
                {% endif %}
                {{ include(template, {'field': f.convertToArray(), 'id': f.alias, 'formName': f.form.generateFormName()}) }}
            {% endif %}
        {% endfor %}
    </form>
</div>
