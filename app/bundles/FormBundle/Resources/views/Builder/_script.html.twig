{% set src = 'dev' == app.environment ? 'app/assets/js/mailvotech-form-src.js' : 'media/js/mailvotech-form.js' %}
{% set scriptSrc = getAssetUrl(src, null, null, true)|replace({
    '/index.php': ''
}) %}

<script type="text/javascript">
    /** This section is only needed once per page if manually copying **/
    if (typeof MailVotechSDKLoaded == 'undefined') {
        var MailVotechSDKLoaded = true;
        var head            = document.getElementsByTagName('head')[0];
        var script          = document.createElement('script');
        script.type         = 'text/javascript';
        script.src          = '{{ scriptSrc }}';
        script.onload       = function() {
            MailVotechSDK.onLoad();
        };
        head.appendChild(script);
        var MailVotechDomain = '{{ assetGetBaseUrl()|replace({'/index.php': ''}) }}';
        var MailVotechLang   = {
            'submittingMessage': "{{ 'mailvotech.form.submission.pleasewait'|trans([], 'messages', form.getLanguage())}}"
        }
    }else if (typeof MailVotechSDK != 'undefined') {
        MailVotechSDK.onLoad();
    }
</script>
