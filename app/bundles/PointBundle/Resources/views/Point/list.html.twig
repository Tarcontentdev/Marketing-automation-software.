{% set isIndex = 'index' == tmpl %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MailVotechCore/Default/content.html.twig' : '@MailVotechCore/Default/raw_output.html.twig' %}

{% block mailvotechContent 'point' %}

{% block headerTitle 'mailvotech.points.menu.root'|trans %}

{% block content %}
  {% if isIndex %}
    <div id="page-list-wrapper" class="{% if items|length > 0 or searchValue is not empty %}panel {% endif %}panel-default">
        {{ include('@MailVotechCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'action': currentRoute,
            'page_actions': {
                'templateButtons': {
                    'new': permissions['point:points:create'],
                },
                'routeBase': 'point',
            },
            'bulk_actions': {
                'routeBase': 'point',
                'templateButtons': {
                    'delete': permissions['point:points:delete'],
                },
            },
            'quickFilters': [
                {
                    'search': 'mailvotech.core.searchcommand.ispublished',
                    'label': 'mailvotech.core.form.active',
                    'tooltip': 'mailvotech.core.searchcommand.ispublished.description',
                    'icon': 'ri-check-line'
                },
                {
                    'search': 'mailvotech.core.searchcommand.isunpublished',
                    'label': 'mailvotech.core.form.inactive',
                    'tooltip': 'mailvotech.core.searchcommand.isunpublished.description',
                    'icon': 'ri-close-line'
                },
                {
                    'search': 'mailvotech.core.searchcommand.isuncategorized',
                    'label': 'mailvotech.core.form.uncategorized',
                    'tooltip': 'mailvotech.core.searchcommand.isuncategorized.description',
                    'icon': 'ri-folder-unknow-line'
                },
                {
                    'search': 'mailvotech.core.searchcommand.ismine',
                    'label': 'mailvotech.core.searchcommand.ismine.label',
                    'tooltip': 'mailvotech.core.searchcommand.ismine.description',
                    'icon': 'ri-user-line'
                }
            ]
        }) }}
        <div class="page-list">
  {% endif %}

  {{ include('@MailVotechPoint/Point/_list.html.twig') }}

  {% if isIndex %}
        </div>
    </div>

    {{ include('@MailVotechCore/Modules/protip.html.twig', {
      tip: random(['mailvotech.protip.points.decay', 'mailvotech.protip.points.reduce', 'mailvotech.protip.points.limit'])
  }) }}
  {% endif %}
{% endblock %}
