{
    "name": "mailvotech/mailvotech",
    "license": "GPL-3.0",
    "type": "project",
    "description": "MailVotech Marketing Automation Distribution",
    "require": {
        "cweagans/composer-patches": "^1.7.3",
        "mailvotech/core-lib": "^7.0",
        "mailvotech/composer-installer": "^1.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.1",
        "codeception/module-asserts": "^3.0",
        "codeception/module-db": "^3.1",
        "codeception/module-webdriver": "^4.0",
        "friendsofphp/php-cs-fixer": "^v3.95.11",
        "http-interop/http-factory-guzzle": "^1.0",
        "liip/functional-test-bundle": "^4.3",
        "liip/test-fixtures-bundle": "^3.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2.6",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^11.5",
        "rector/type-perfect": "^2.1.4",
        "rector/rector": "dev-main",
        "symfony/browser-kit": "~7.4.0",
        "symfony/dom-crawler": "~7.4.0",
        "symfony/maker-bundle": "^1.64",
        "symfony/phpunit-bridge": "~7.4.0",
        "symfony/var-dumper": "~7.4.0",
        "symfony/web-profiler-bundle": "~7.4.0",
        "symplify/easy-coding-standard": "^13.2.17",
        "symplify/phpstan-rules": "^14.10",
        "tomasvotruba/type-coverage": "^2.2.1",
        "mautic/transifex": "^5.0"
    },
    "replace": {
        "mailvotech/grapes-js-builder-bundle": "self.version",
        "mailvotech/plugin-clearbit": "self.version",
        "mailvotech/plugin-cloudstorage": "self.version",
        "mailvotech/plugin-crm": "self.version",
        "mailvotech/plugin-emailmarketing": "self.version",
        "mailvotech/plugin-focus": "self.version",
        "mailvotech/plugin-fullcontact": "self.version",
        "mailvotech/plugin-gmail": "self.version",
        "mailvotech/plugin-outlook": "self.version",
        "mailvotech/plugin-social": "self.version",
        "mailvotech/plugin-zapier": "self.version",
        "mailvotech/plugin-tagmanager": "self.version",
        "mailvotech/theme-aurora": "self.version",
        "mailvotech/theme-blank": "self.version",
        "mailvotech/theme-brienz": "self.version",
        "mailvotech/theme-cards": "self.version",
        "mailvotech/theme-confirmme": "self.version",
        "mailvotech/theme-fresh-center": "self.version",
        "mailvotech/theme-fresh-fixed": "self.version",
        "mailvotech/theme-fresh-left": "self.version",
        "mailvotech/theme-fresh-wide": "self.version",
        "mailvotech/theme-goldstar": "self.version",
        "mailvotech/theme-neopolitan": "self.version",
        "mailvotech/theme-oxygen": "self.version",
        "mailvotech/theme-paprika": "self.version",
        "mailvotech/theme-skyline": "self.version",
        "mailvotech/theme-sparse": "self.version",
        "mailvotech/theme-sunday": "self.version",
        "mailvotech/theme-vibrant": "self.version",
        "mailvotech/theme-1-2-1-2-column": "self.version",
        "mailvotech/theme-1-2-1-column": "self.version",
        "mailvotech/theme-1-2-column": "self.version",
        "mailvotech/theme-1-3-1-3-column": "self.version",
        "mailvotech/theme-1-3-column": "self.version",
        "mailvotech/theme-attract": "self.version",
        "mailvotech/theme-connect-through-content": "self.version",
        "mailvotech/theme-creative": "self.version",
        "mailvotech/theme-educate": "self.version",
        "mailvotech/theme-gallery": "self.version",
        "mailvotech/theme-make-announcement": "self.version",
        "mailvotech/theme-showcase": "self.version",
        "mailvotech/theme-simple-text": "self.version",
        "mailvotech/theme-survey": "self.version",
        "mailvotech/theme-trulypersonal": "self.version",
        "mailvotech/theme-welcome": "self.version",
        "mailvotech/theme-mono": "self.version",
        "mailvotech/theme-blend": "self.version",
        "mailvotech/theme-capture": "self.version",
        "mailvotech/theme-chord": "self.version",
        "mailvotech/theme-formscape": "self.version",
        "mailvotech/theme-reachout": "self.version",
        "mailvotech/theme-multi-step": "self.version"
    },
    "autoload": {
        "psr-4": {
            "MailVotechPlugin\\": "plugins/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utils\\Rector\\": "utils/rector/src/",
            "Utils\\Rector\\Tests\\": "utils/rector/tests/",
            "Utils\\PHPStan\\": "utils/phpstan/src/",
            "Utils\\PHPStan\\Tests\\": "utils/phpstan/tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "build/composer/mailvotech-installer",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "app",
            "options": {
                "versions": {
                    "mailvotech/core-lib": "7.0.0-dev"
                }
            }
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/SymfonyBridgeBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/oauth2-php"
        }
    ],
    "conflict": {
        "mailvotech/core": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "githooks": [
            "php -r \"if(file_exists('./.git')&&file_exists('./build/hooks/pre-commit'.(PHP_OS=='WINNT'?'.win':''))){copy('./build/hooks/pre-commit'.(PHP_OS=='WINNT'?'.win':''),'./.git/hooks/pre-commit');} if(file_exists('./.git')&&file_exists('./build/hooks/post-checkout')){copy('./build/hooks/post-checkout','./.git/hooks/post-checkout');}\"",
            "php -r \"if(file_exists('./.git/hooks/pre-commit')&&(PHP_OS!='WINNT')){chmod('./.git/hooks/pre-commit',0755);} if(file_exists('./.git/hooks/post-checkout')&&(PHP_OS!='WINNT')){chmod('./.git/hooks/post-checkout',0755);}\""
        ],
        "post-install-cmd": [
            "@githooks",
            "@npm-ci",
            "@npx-patch-package",
            "@gjs-build-safe",
            "@generate-assets",
            "@motd"
        ],
        "post-update-cmd": [
            "@githooks",
            "@npm-ci",
            "@npx-patch-package",
            "@gjs-build-safe",
            "@generate-assets",
            "@motd"
        ],
        "test": "bin/phpunit -d memory_limit=2G --bootstrap vendor/autoload.php --configuration app/phpunit.xml.dist",
        "e2e-test": "APP_ENV=test bin/codecept run acceptance",
        "phpstan": "[ ! -f var/cache/test/AppKernelTestDebugContainer.xml ] && (echo 'Building test cache ...'; APP_ENV=test APP_DEBUG=1 bin/console > /dev/null 2>&1);  php -d memory_limit=5G bin/phpstan analyse --ansi",
        "phpstan-baseline": "composer phpstan -- --generate-baseline phpstan-baseline.neon",
        "cs": "bin/php-cs-fixer fix --config=.php-cs-fixer.php -v --dry-run --diff",
        "fixcs": [
            "bin/php-cs-fixer fix -v",
            "bin/ecs --fix"
        ],
        "rector": "bin/rector process --ansi",
        "npm-ci": "npm ci --prefer-offline --no-audit",
        "npx-patch-package": "npx patch-package",
        "gjs-build": "npm ci --prefix plugins/GrapesJsBuilderBundle --prefer-offline --no-audit && npm run build --prefix plugins/GrapesJsBuilderBundle",
        "gjs-build-safe": "@php build/gjs_build.php",
        "asset-map:clean": "php -r 'if (is_dir(\"assets/build\")) { $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator(\"assets/build\", FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::CHILD_FIRST); foreach ($it as $file) { $file->isDir() ? rmdir($file->getPathname()) : unlink($file->getPathname()); } rmdir(\"assets/build\"); }'",
        "sass:build": [
            "@asset-map:clean",
            "php bin/console sass:build"
        ],
        "sass:watch": [
            "@asset-map:clean",
            "php bin/console sass:build --watch"
        ],
        "generate-assets": "bin/console mailvotech:assets:generate && bin/console assets:install --symlink --relative ./",
        "motd": "bin/console mailvotech:motd"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "bin-dir": "bin",
        "component-dir": "media/assets",
        "process-timeout": 5000,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true,
            "mailvotech/composer-installer": true
        }
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-web-dir": "../",
        "symfony-var-dir": "var",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "public-dir": ".",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        },
        "patches": {
            "twig/twig": {
                "Make IntegrationTestCase data providers static for PHPUnit 11": "patches/twig-integration-testcase-static-data-providers.patch"
            }
        }
    }
}
