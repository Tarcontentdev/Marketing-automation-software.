
{
  "name": "mailvotech/recommended-project",
  "description": "Project template for MailVotech projects with Composer",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.mailvotech.org/mailvotech-releases",
  "support": {
    "user-docs": "https://docs.mailvotech.org/en",
    "developer-docs": "https://devdocs.mailvotech.org",
    "chat": "https://www.mailvotech.org/slack"
  },
  "funding": [
    {
      "type": "other",
      "url": "https://opencollective.com/mailvotech"
    },
    {
      "type": "other",
      "url": "https://github.com/sponsors/mailvotech"
    }
  ],
  "authors": [
    {
      "name": "",
      "role": ""
    }
  ],
  "require": {
    "composer/installers": "^1.11",
    "mautic/core-composer-scaffold": "4.x-dev",
    "mautic/core-project-message": "4.x-dev",
    "mailvotech/core-lib": "*",
    "mailvotech/grapes-js-builder-bundle": "*",
    "mailvotech/plugin-clearbit": "*",
    "mailvotech/plugin-cloudstorage": "*",
    "mailvotech/plugin-crm": "*",
    "mailvotech/plugin-emailmarketing": "*",
    "mailvotech/plugin-focus": "*",
    "mailvotech/plugin-fullcontact": "*",
    "mailvotech/plugin-gmail": "*",
    "mailvotech/plugin-outlook": "*",
    "mailvotech/plugin-social": "*",
    "mailvotech/plugin-tagmanager": "*",
    "mailvotech/plugin-zapier": "*",
    "mailvotech/theme-aurora": "*",
    "mailvotech/theme-blank": "*",
    "mailvotech/theme-brienz": "*",
    "mailvotech/theme-cards": "*",
    "mailvotech/theme-confirmme": "*",
    "mailvotech/theme-fresh-center": "*",
    "mailvotech/theme-fresh-fixed": "*",
    "mailvotech/theme-fresh-left": "*",
    "mailvotech/theme-fresh-wide": "*",
    "mailvotech/theme-goldstar": "*",
    "mailvotech/theme-neopolitan": "*",
    "mailvotech/theme-oxygen": "*",
    "mailvotech/theme-paprika": "*",
    "mailvotech/theme-skyline": "*",
    "mailvotech/theme-sparse": "*",
    "mailvotech/theme-sunday": "*",
    "mailvotech/theme-vibrant": "*",
    "mailvotech/theme-trulypersonal": "*",
    "mailvotech/theme-1-2-1-2-column": "*",
    "mailvotech/theme-1-2-1-column": "*",
    "mailvotech/theme-1-2-column": "*",
    "mailvotech/theme-1-3-1-3-column": "*",
    "mailvotech/theme-1-3-column": "*",
    "mailvotech/theme-attract": "*",
    "mailvotech/theme-connect-through-content": "*",
    "mailvotech/theme-creative": "*",
    "mailvotech/theme-educate": "*",
    "mailvotech/theme-gallery": "*",
    "mailvotech/theme-make-announcement": "*",
    "mailvotech/theme-showcase": "*",
    "mailvotech/theme-simple-text": "*",
    "mailvotech/theme-survey": "*",
    "mailvotech/theme-welcome": "*",
    "mailvotech/theme-mono": "*",
    "mailvotech/theme-blend": "*",
    "mailvotech/theme-capture": "*",
    "mailvotech/theme-chord": "*",
    "mailvotech/theme-formscape": "*",
    "mailvotech/theme-reachout": "*"
  },
  "scripts": {
    "post-install-cmd": [
      "@fix-permissions",
      "@generate-assets"
    ],
    "post-update-cmd": [
      "@fix-permissions",
      "@generate-assets"
    ],
    "fix-permissions": "chmod 750 ./bin/console",
    "generate-assets": [
      "npm ci",
      "npx patch-package",
      "bin/console mailvotech:assets:generate"
    ]
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/mautic/SymfonyBridgeBundle.git"
    },
    {
        "type": "path",
        "url": "../app",
        "options": {
            "versions": {
                "mailvotech/core-lib": "7.x-dev"
            },
            "symlink": false
        }
    },
    {
        "type": "path",
        "url": "../themes/**",
        "options": {
            "symlink": false
        }
    },
    {
        "type": "path",
        "url": "../plugins/**",
        "options": {
            "symlink": false
        }
    }
  ],
  "conflict": {
    "mailvotech/mailvotech": "*",
    "mailvotech/core": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "secure-http": false,
    "allow-plugins": {
      "composer/installers": true,
      "composer/package-versions-deprecated": true,
      "symfony/flex": true,
      "mautic/core-composer-scaffold": true,
      "mautic/core-project-message": true,
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "MailVotechPlugin\\": "docroot/plugins/"
    }
  },
  "extra": {
    "mautic-scaffold": {
      "locations": {
        "web-root": "docroot/"
      }
    },
    "public-dir": "docroot",
    "installer-paths": {
      "docroot/app": [
        "type:mailvotech-core"
      ],
      "docroot/plugins/{$name}": [
        "type:mailvotech-plugin"
      ],
      "docroot/themes/{$name}": [
        "type:mailvotech-theme"
      ]
    },
    "mailvotech-core-project-message": {
      "include-keys": [
        "homepage",
        "support"
      ],
      "post-create-project-cmd-message": [
        "<bg=blue;fg=white>                                                         </>",
        "<bg=blue;fg=white>  Congratulations, you’ve installed the MailVotech codebase  </>",
        "<bg=blue;fg=white>  from the mailvotech/recommended-project template!          </>",
        "<bg=blue;fg=white>                                                         </>",
        "",
        "<bg=yellow;fg=black>Next steps</>:",
        "  * Install MailVotech",
        "  * Read the user guide",
        "  * Get support: https://www.mailvotech.org/support",
        "  * Get involved with the MailVotech community:",
        "      https://www.mailvotech.org/getting-involved",
        "  * Remove the plugin that prints this message:",
        "      composer remove mautic/core-project-message"
      ]
    }
  }
}
