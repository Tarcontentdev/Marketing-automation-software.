# syntax=docker/dockerfile:1.7

ARG PHP_BASE=8.4-apache-bookworm


# =============================================================================
# BUILD STAGE
# =============================================================================

FROM php:${PHP_BASE} AS builder

ARG IPE_VERSION=2.9.28
ARG IPE_SHA256=2f5970453effac47cfcceafd6103948d78b566c2fb922a8ff639fe249db74aa7

ENV APP_ENV=prod \
    APP_DEBUG=0 \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_MEMORY_LIMIT=-1 \
    COMPOSER_PROCESS_TIMEOUT=10000

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        curl \
        git \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
      "https://github.com/mlocati/docker-php-extension-installer/releases/download/${IPE_VERSION}/install-php-extensions" \
      -o /usr/local/bin/install-php-extensions \
    && echo "${IPE_SHA256}  /usr/local/bin/install-php-extensions" | sha256sum -c - \
    && chmod +x /usr/local/bin/install-php-extensions \
    && install-php-extensions \
        intl \
        mbstring \
        mysqli \
        curl \
        pdo_mysql \
        zip \
        bcmath \
        sockets \
        exif \
        amqp \
        gd \
        imap \
        opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install --no-install-recommends -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

COPY . .

RUN composer install \
      --no-dev \
      --prefer-dist \
      --no-interaction \
      --no-progress \
      --optimize-autoloader


# =============================================================================
# PRODUCTION RUNTIME
# =============================================================================

FROM php:${PHP_BASE} AS runtime

LABEL org.opencontainers.image.title="MailVotech"
LABEL org.opencontainers.image.description="Tarcontent MailVotech marketing automation platform"
LABEL org.opencontainers.image.vendor="Tarcontent Developers Limited"
LABEL org.opencontainers.image.source="https://github.com/Tarcontentdev/Marketing-automation-software."

ENV APP_ENV=prod \
    APP_DEBUG=0

COPY --from=builder \
    /usr/local/lib/php/extensions \
    /usr/local/lib/php/extensions

COPY --from=builder \
    /usr/local/etc/php/conf.d \
    /usr/local/etc/php/conf.d

COPY --from=builder \
    /usr/bin/composer \
    /usr/bin/composer

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        cron \
        curl \
        git \
        libavif15 \
        librabbitmq4 \
        libfreetype6 \
        libjpeg62-turbo \
        libpng16-16 \
        libwebp7 \
        libc-client2007e \
        libxpm4 \
        libzip4 \
        mariadb-client \
        supervisor \
        tini \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
      'date.timezone = Africa/Lagos' \
      'memory_limit = 512M' \
      'upload_max_filesize = 128M' \
      'post_max_size = 128M' \
      'max_execution_time = 300' \
      > /usr/local/etc/php/conf.d/zz-mailvotech-production.ini

WORKDIR /var/www/html

COPY --from=builder \
    --chown=www-data:www-data \
    /var/www/html \
    /var/www/html

COPY .github/docker/mailvotech-entrypoint.sh \
     /usr/local/bin/mailvotech-entrypoint

COPY .github/docker/supervisord-mailvotech.conf \
     /etc/supervisor/conf.d/mailvotech.conf

COPY .github/docker/mailvotech-cron \
     /etc/cron.d/mailvotech

RUN chmod 0755 /usr/local/bin/mailvotech-entrypoint \
    && chmod 0644 /etc/cron.d/mailvotech \
    && a2enmod rewrite headers expires \
    && printf '%s\n' \
        '<Directory /var/www/html>' \
        '    Options FollowSymLinks' \
        '    AllowOverride All' \
        '    Require all granted' \
        '</Directory>' \
        > /etc/apache2/conf-available/mailvotech.conf \
    && a2enconf mailvotech \
    && mkdir -p \
        /var/www/html/config \
        /var/www/html/var/cache \
        /var/www/html/var/logs \
        /var/www/html/var/tmp \
        /var/www/html/media/files \
        /var/www/html/media/images \
    && chown -R www-data:www-data \
        /var/www/html/config \
        /var/www/html/var \
        /var/www/html/media/files \
        /var/www/html/media/images

VOLUME [ \
    "/var/www/html/config", \
    "/var/www/html/var/logs", \
    "/var/www/html/media/files", \
    "/var/www/html/media/images" \
]

EXPOSE 80

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/mailvotech-entrypoint"]

CMD ["web"]
